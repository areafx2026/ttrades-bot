# ─── Pivot v3.0 configuration ───────────────────────────────────────────────
# Copy to .env and fill in. All values have sane defaults except MT5 creds.

# Database — SQLite for dev, Postgres for prod (same code, just change the URL)
DATABASE_URL=sqlite:///./pivot.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/pivot

# MT5 (leave blank to attach to an already-logged-in terminal)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Strategy
SYMBOLS=["EURUSD","GBPUSD","USDJPY","AUDUSD","EURGBP","EURJPY","USDCAD"]
RR=1.3
MIN_TOUCHES=4
ZONE_TOLERANCE_ATR=0.5
APPROACH_ZONES=1.0

# Risk / guardrails
RISK_EUR=100
MAX_OPEN_TRADES=3
MAX_LOTS=1.0
SCAN_INTERVAL_S=60
